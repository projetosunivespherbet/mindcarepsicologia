# URL da API (Cloudflare Worker). Em desenvolvimento: wrangler dev
VITE_API_URL="http://localhost:8787"

# Captcha opcional (Cloudflare Turnstile): chave PÚBLICA do site. Configure junto com o segredo TURNSTILE_SECRET no Worker:
# as duas coisas ligam ou as duas ficam vazias. Sem elas, o login funciona sem captcha.
# VITE_TURNSTILE_SITE_KEY=""
